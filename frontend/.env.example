# Frontend environment variables for Vercel deployment
# Copy these into Vercel Project Settings → Environment Variables

# Clerk authentication (required for auth features)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Backend API URL (defaults to https://opsmindai3.onrender.com if not set)
VITE_API_URL=https://opsmindai3.onrender.com
