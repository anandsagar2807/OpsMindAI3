# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/opsmind-ai?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Groq API (Required for Chat)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Embedding Provider (simple, gemini, or openai)
EMBEDDING_PROVIDER=simple

# Optional: Google Gemini (if using gemini provider)
# GEMINI_API_KEY=your-gemini-api-key

# Optional: OpenAI (if using openai provider)
# OPENAI_API_KEY=your-openai-api-key

# File Upload
MAX_FILE_SIZE=20971520
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
